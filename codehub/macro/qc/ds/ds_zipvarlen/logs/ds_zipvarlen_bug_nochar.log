1          /*===============================================================================
2           * ds_zipvarlen_bug_nochar.sas - Regression test: ERROR noise on no-char dataset
3           *===============================================================================
4           * Defect       : when the input dataset has NO character variables, %cvarlist
5           *               resolves to an empty string and
6           *                   %let cvarcount=%sysfunc(countw(&cvarlist.));
7           *               is submitted as countw() with no argument, which makes SAS log
8           *                   ERROR: Argument ... COUNTW ... too few
9           *               The macro still finishes correctly (it falls through to the
10          *               "contains none character variables" branch), so the defect is
11          *               log pollution rather than a wrong result.
12          * Root cause   : countw() must be guarded, e.g.
13          *                   %if %bquote(&cvarlist.)^=%str() %then %let cvarcount=%sysfunc(countw(&cvarlist.));
14          *                   %else %let cvarcount=0;
15          * Expected     : (once fixed) no ERROR line in the log; the assertions below
16          *                keep passing and the log becomes clean
17          * Current      : DEFECT - assertions pass but an ERROR is emitted
18          *============================================================================*/
19         
20         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
21         %let _qcboot_=%sysfunc(getoption(sysin));
22         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
23         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
24         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
25         %include "&_qcboot_.\_framework\qc_env.sas";
90         %let _qcboot_=;
