754        %macro _qc_build_lzl(libref=);
755          %let _lzdir_=&_QCSB_.\&libref.;
756          %_qc_sb_del(path=&_lzdir_.);
757          data _null_;
758            rc=dcreate("&libref.", "&_QCSB_.\");
759          run;
760          libname &libref. "&_lzdir_.";
761        %mend _qc_build_lzl;
