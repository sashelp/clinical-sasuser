561        %qc_begin(prog=lib_memlist_bug_typepattern, macro=lib_memlist);
#####QC_BEGIN prog=lib_memlist_bug_typepattern macro=lib_memlist
562        %qc_case(desc=B1 TYPE plus PATTERN must return the filtered list);
#####QC_CASE n=1 desc=B1 TYPE plus PATTERN must return the filtered list
563        
564        %let _syscc_before=&syscc.;
565        %let _pat=%nrstr(/^ALPHA/);
566        %let _r=%lib_memlist(library=lmb,type=data,pattern=%superq(_pat));
567        %let _syscc_after=&syscc.;
568        
569        /* a non-zero syscc means the macro raised an ERROR instead of filtering */
570        %qc_check_eq(actual=&_syscc_after., expect=&_syscc_before.,
571          desc=B1 no ERROR raised for TYPE plus PATTERN);
#####QC_PASS n=1 desc=B1 no ERROR raised for TYPE plus PATTERN
572        
573        /* expected result once fixed: only the data set ALPHA matches ^ALPHA in TYPE=DATA */
574        %qc_check_eq(actual=&_r., expect=ALPHA,
575          desc=B1 TYPE=DATA with pattern ^ALPHA returns ALPHA);
#####QC_PASS n=1 desc=B1 TYPE=DATA with pattern ^ALPHA returns ALPHA
576        
577        %qc_end;
#####QC_RESULT prog=lib_memlist_bug_typepattern macro=lib_memlist STATUS=PASS ncase=1 npass=2 nfail=0
