1          /*===============================================================================
2           * lib_memlist_bug_typepattern.sas - Regression test: TYPE= + PATTERN= together
3           *===============================================================================
4           * Defect       : in dev/lib/lib_memlist.sas the parameter checks form a single
5           *                %ELSE IF chain:
6           *                    %else %if %quote(&type.)^=%str() %then %do; ... %end;
7           *                    %else %if %bquote(&pattern.)^=%str() %then %do;
8           *                      %let pat=%sysfunc(prxparse(...));
9           *                    %end;
10          *                As soon as TYPE= is non-empty the first branch is taken, so the
11          *                PATTERN branch is skipped and %let pat=... never executes.
12          *                The core loop then calls prxmatch(&pat.,...) with an EMPTY
13          *                pattern, producing:
14          *                    ERROR: The regular expression passed to PRXMATCH contains
15          *                           a syntax error.
16          *                and the macro terminates without returning a member list.
17          * Root cause   : PATTERN validation must not be an %ELSE branch of the TYPE
18          *                check; both must be evaluated (two independent %IF blocks).
19          * Expected     : (once fixed) TYPE=DATA + PATTERN= returns the filtered list
20          * Current      : DEFECT - the call aborts / emits ERROR instead of filtering
21          *============================================================================*/
22         
23         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
24         %let _qcboot_=%sysfunc(getoption(sysin));
25         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
26         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
27         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
