562        %qc_begin(prog=lib_memlist_test, macro=lib_memlist);
#####QC_BEGIN prog=lib_memlist_test macro=lib_memlist
563        
564        /*----------------------------------------------------------------------------
565         * CASE 1 : no filter -> all members, upcased
5                                                       SAS 系统       2026年11月 9日 星期一 下午02时05分00秒

566         *--------------------------------------------------------------------------*/
567        %qc_case(desc=1 all members);
#####QC_CASE n=1 desc=1 all members
568        %let _r=%lib_memlist(library=lmlib);
569        %qc_expect_cnt(list=&_r., expect=4, desc=C1 four members total);
#####QC_PASS n=1 desc=C1 four members total
570        %qc_check(cond=%index(%bquote(&_r.),ALPHA)>0, desc=C1 contains ALPHA);
#####QC_PASS n=1 desc=C1 contains ALPHA
571        %qc_check(cond=%index(%bquote(&_r.),BETA)>0, desc=C1 contains BETA);
#####QC_PASS n=1 desc=C1 contains BETA
572        %qc_check(cond=%index(%bquote(&_r.),GAMMA)>0, desc=C1 contains GAMMA);
#####QC_PASS n=1 desc=C1 contains GAMMA
573        
574        /*----------------------------------------------------------------------------
575         * CASE 2 : TYPE=DATA -> only data sets
576         *--------------------------------------------------------------------------*/
577        %qc_case(desc=2 TYPE=DATA);
#####QC_CASE n=2 desc=2 TYPE=DATA
578        %let _r=%lib_memlist(library=lmlib,type=data);
579        %qc_expect_cnt(list=&_r., expect=3, desc=C2 three data sets);
#####QC_PASS n=2 desc=C2 three data sets
580        %qc_check(cond=%index(%bquote(&_r.),ALPHAVW)=0, desc=C2 view excluded);
#####QC_PASS n=2 desc=C2 view excluded
581        
582        /*----------------------------------------------------------------------------
583         * CASE 3 : TYPE=VIEW -> only views
584         *--------------------------------------------------------------------------*/
585        %qc_case(desc=3 TYPE=VIEW);
#####QC_CASE n=3 desc=3 TYPE=VIEW
586        %let _r=%lib_memlist(library=lmlib,type=view);
587        %qc_expect_cnt(list=&_r., expect=1, desc=C3 one view);
#####QC_PASS n=3 desc=C3 one view
588        %qc_check_eq(actual=&_r., expect=ALPHAVW, desc=C3 view name ALPHAVW);
#####QC_PASS n=3 desc=C3 view name ALPHAVW
589        
590        /*----------------------------------------------------------------------------
591         * CASE 4 : TYPE= value case-insensitivity
592         *--------------------------------------------------------------------------*/
593        %qc_case(desc=4 TYPE case-insensitive);
#####QC_CASE n=4 desc=4 TYPE case-insensitive
594        %let _r=%lib_memlist(library=lmlib,type=DaTa);
595        %qc_expect_cnt(list=&_r., expect=3, desc=C4 mixed-case DaTa gives 3);
#####QC_PASS n=4 desc=C4 mixed-case DaTa gives 3
596        
597        /*----------------------------------------------------------------------------
598         * CASE 5 : PATTERN regex filter (prefix)
599         *--------------------------------------------------------------------------*/
600        %qc_case(desc=5 PATTERN prefix);
#####QC_CASE n=5 desc=5 PATTERN prefix
601        %let _pat=%nrstr(/^ALPHA/);
602        %let _r=%lib_memlist(library=lmlib,pattern=%superq(_pat));
603        %qc_check(cond=%index(%bquote(&_r.),ALPHAVW)>0, desc=C5 pattern ^ALPHA matches view);
#####QC_PASS n=5 desc=C5 pattern ^ALPHA matches view
604        %qc_check(cond=%index(%bquote(&_r.),BETA)=0, desc=C5 BETA filtered out);
#####QC_PASS n=5 desc=C5 BETA filtered out
605        
606        /*----------------------------------------------------------------------------
607         * CASE 6 : (removed) TYPE + PATTERN combined -- see the known defect locked by
608         *           lib_memlist_bug_typepattern.sas (the %else-if chain skips the
609         *           PATTERN branch whenever TYPE= is non-empty, so prxparse() is never
610         *           called and PRXMATCH receives an empty regex).
611         *--------------------------------------------------------------------------*/
612        
613        /*----------------------------------------------------------------------------
614         * CASE 7 : no match -> empty result
615         *--------------------------------------------------------------------------*/
6                                                       SAS 系统       2026年11月 9日 星期一 下午02时05分00秒

616        %qc_case(desc=7 no match empty);
#####QC_CASE n=6 desc=7 no match empty
