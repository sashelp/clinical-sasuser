523        %qc_begin(prog=dir_exist_test, macro=dir_exist);
#####QC_BEGIN prog=dir_exist_test macro=dir_exist
524        
4                                                       SAS 系统       2026年11月 9日 星期一 下午02时04分00秒

525        /*----------------------------------------------------------------------------
526         * CASE 1 : existing directories return 1
527         *--------------------------------------------------------------------------*/
528        %qc_case(desc=1 existing directory);
#####QC_CASE n=1 desc=1 existing directory
529        %let _r=%dir_exist(dir=&_QCSB_D1_.);
530        %qc_check_eq(actual=&_r., expect=1, desc=C1 d1 exists);
#####QC_PASS n=1 desc=C1 d1 exists
531        %let _r=%dir_exist(dir=&_QCSB_.);
532        %qc_check_eq(actual=&_r., expect=1, desc=C1 sandbox root exists);
#####QC_PASS n=1 desc=C1 sandbox root exists
533        
534        /*----------------------------------------------------------------------------
535         * CASE 2 : missing directory returns 0
536         *--------------------------------------------------------------------------*/
537        %qc_case(desc=2 missing directory);
#####QC_CASE n=2 desc=2 missing directory
538        %let _r=%dir_exist(dir=&_QCSB_.\no_such_dir_xyz);
539        %qc_check_eq(actual=&_r., expect=0, desc=C2 missing dir returns 0);
#####QC_PASS n=2 desc=C2 missing dir returns 0
540        
541        /*----------------------------------------------------------------------------
542         * CASE 3 : nested directory returns 1
543         *--------------------------------------------------------------------------*/
544        %qc_case(desc=3 nested directory);
#####QC_CASE n=3 desc=3 nested directory
545        %let _r=%dir_exist(dir=&_QCSB_D1S1_.);
546        %qc_check_eq(actual=&_r., expect=1, desc=C3 nested sub1 exists);
#####QC_PASS n=3 desc=C3 nested sub1 exists
547        %let _r=%dir_exist(dir=&_QCSB_D1S2_.);
548        %qc_check_eq(actual=&_r., expect=1, desc=C3 nested sub2 exists);
#####QC_PASS n=3 desc=C3 nested sub2 exists
549        
550        /*----------------------------------------------------------------------------
551         * CASE 4 : quoted path is dequoted internally
552         *--------------------------------------------------------------------------*/
553        %qc_case(desc=4 quoted path);
#####QC_CASE n=4 desc=4 quoted path
554        %let _r=%dir_exist(dir="&_QCSB_D1_.");
555        %qc_check_eq(actual=&_r., expect=1, desc=C4 quoted d1 path exists);
#####QC_PASS n=4 desc=C4 quoted d1 path exists
556        %let _r=%dir_exist(dir="&_QCSB_.\no_such_dir_xyz");
557        %qc_check_eq(actual=&_r., expect=0, desc=C4 quoted missing path returns 0);
#####QC_PASS n=4 desc=C4 quoted missing path returns 0
558        
559        /*----------------------------------------------------------------------------
560         * CASE 5 : path resolved from a macro variable
561         *--------------------------------------------------------------------------*/
562        %qc_case(desc=5 macro variable path);
#####QC_CASE n=5 desc=5 macro variable path
563        %let _pv=&_QCSB_D2_.;
564        %let _r=%dir_exist(dir=&_pv.);
565        %qc_check_eq(actual=&_r., expect=1, desc=C5 macro variable d2 exists);
#####QC_PASS n=5 desc=C5 macro variable d2 exists
566        
567        /*----------------------------------------------------------------------------
568         * CASE 6 : a file path must return 0, not be treated as a directory
569         *--------------------------------------------------------------------------*/
570        %qc_case(desc=6 file path is not a directory);
#####QC_CASE n=6 desc=6 file path is not a directory
571        %let _r=%dir_exist(dir=&_QCSB_TXT_.);
572        %qc_check_eq(actual=&_r., expect=0, desc=C6 file path returns 0);
#####QC_PASS n=6 desc=C6 file path returns 0
573        
574        %qc_end;
