1          /*===============================================================================
2           * sdtm_epoch_bug_trtstale.sas - Bug regression: stale TRT values when unmatched
3           *===============================================================================
4           * Macro under test : %sdtm_epoch
5           * Expected         : an event outside every SE interval stays unmapped, even
6           *                    when the treatment EPOCH is the last SE record
7           * Status           : OPEN 2026-11-09 - TRTEPOCH= boundary branch added
8           * Original defect  : the TRTEPOCH branch has no final else call missing(), so a
9           *                    non-matching TRT record leaves its SESTDTC/SEENDTC/EPOCH in
10          *                    the PDV; when it is the last record the event is mapped to
11          *                    TRT although DTC is in a gap or before the first SESTDTC
12          * Fix              : add else call missing(sestdtc,seendtc,epoch) at the end of
13          *                    the if epoch=&trtepoch. do block
14          * Test passes when  the defect is fixed (run_all then reports FIXED).
15          *============================================================================*/
16         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
17         %let _qcboot_=%sysfunc(getoption(sysin));
18         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\\)))-1));
