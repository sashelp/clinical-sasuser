650        /*----------------------------------------------------------------------------
651         * Test data
652         *   se_ep  : standard SE extract, sorted by USUBJID SESTDTC
653         *            S01 SCRN/TRT/FU, S02 SCRN/TRT with a missing last SEENDTC,
654         *            S03 SCRN/TRT with a date gap
655         *   ae_doc : documented use case, record date variable AESTDTC only
656         *   av_ep  : same events plus a non-missing auxiliary VSDTC, used to observe
657         *            the mapping rules independently of the current VSDTC gate defect
658         *--------------------------------------------------------------------------*/
659        data se_ep;
