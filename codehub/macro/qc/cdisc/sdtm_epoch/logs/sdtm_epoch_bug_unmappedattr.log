1          /*===============================================================================
2           * sdtm_epoch_bug_unmappedattr.sas - Bug regression: unmapped record keeps attrs
3           *===============================================================================
4           * Macro under test : %sdtm_epoch
5           * Expected         : a record with no EPOCH match must not carry SESTDTC/SEENDTC
6           *                    values belonging to another epoch
7           * Status           : OPEN
8           * Original defect  : SESTDTC and SEENDTC are assigned only inside the match
9           *                    branch; they keep the last SE record of the subject, so an
10          *                    event before the first SESTDTC still shows SE dates
11          * Test passes when the defect is fixed (run_all then reports FIXED)
12          *============================================================================*/
13         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
14         %let _qcboot_=%sysfunc(getoption(sysin));
15         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\\)))-1));
16         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\\)))-1));
17         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\\)))-1));
