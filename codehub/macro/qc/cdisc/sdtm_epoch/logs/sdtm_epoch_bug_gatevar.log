1          /*===============================================================================
2           * sdtm_epoch_bug_gatevar.sas - Bug regression: mapping gated on hard-coded VSDTC
3           *===============================================================================
4           * Macro under test : %sdtm_epoch
5           * Expected         : EPOCH is selected by the date variable named in DTC=, and
6           *                    an unrelated VSDTC column must not affect the result
7           * Status           : OPEN
8           * Original defect  : the match block is controlled by a hard-coded "if vsdtc^=''"
9           *                    test. DATA= without VSDTC leaves every record unmapped and
10          *                    adds a spurious numeric VSDTC to OUT=, so the documented
11          *                    DTC= contract is not met unless VSDTC happens to exist
12          * Test passes when the defect is fixed (run_all then reports FIXED)
13          *============================================================================*/
14         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
15         %let _qcboot_=%sysfunc(getoption(sysin));
16         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\\)))-1));
17         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\\)))-1));
18         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\\)))-1));
