1          /*===============================================================================
2           * sdtm_lobxfl_bug_compile.sas - Bug regression: baseline flag statement not generated
3           *===============================================================================
4           * Macro under test : %sdtm_lobxfl
5           * Expected         : a normal call creates the flag variable and flags the
6           *                    latest eligible record of each subject-by-test group
7           * Status           : OPEN 2026-11-07 - one source defect still blocks every call
8           *                    (the surplus %END reported earlier was removed at 21:40)
9           * Original defect  : dev/cdisc/sdtm_lobxfl.sas lines 130-131 emit the flag
10          *                    statement through
11          *                    %str(if last.%scan(&by.,-1,%str( )) then &blfl.='Y';);
12          *                    the blank delimiter inside %STR is lost while the text
13          *                    is compiled, the generated statement becomes
14          *                    "if last. then LOBXFL='Y';" and SAS reports
15          *                    "ERROR: 宏函数 %SCAN 的参数过少" followed by ERROR 22-322.
16          *                    The DATA step sdtm_lobxfl2 stops, so no record is flagged
17          *                    and the output dataset keeps a blank BLFL for every row.
18          * Fix              : derive the last BY variable (or the last SUBJECT variable
19          *                    when BY= is blank) into a local macro variable and emit
20          *                    the IF statement without nesting %SCAN inside %STR
21          * Test passes when  the defect is fixed (run_all then reports FIXED).
22          *============================================================================*/
23         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
24         %let _qcboot_=%sysfunc(getoption(sysin));
25         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
26         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
