983        /* helper: count the rows of a dataset that satisfy a condition */
984        %macro _qc_rows(ds=, where=, expect=1, desc=);
985          %local rc;
986          proc sql noprint;
987            select count(*) into :rc from &ds. where &where.;
988          quit;
989          %qc_check_eq(actual=&rc., expect=&expect., desc=&desc.);
990        %mend _qc_rows;
991        
992        /* helper: read a column label through PROC CONTENTS OUT= */
993        %macro _qc_lbl(ds=, var=, mac=);
994          %global &mac.;
