980        /* helper: count the rows of a dataset that satisfy a condition */
981        %macro _qc_rows(ds=, where=, expect=1, desc=);
982          %local rc;
983          proc sql noprint;
984            select count(*) into :rc from &ds. where &where.;
985          quit;
986          %qc_check_eq(actual=&rc., expect=&expect., desc=&desc.);
987        %mend _qc_rows;
988        
989        /* helper: read a column label through PROC CONTENTS OUT= */
990        %macro _qc_lbl(ds=, var=, mac=);
991          %global &mac.;
