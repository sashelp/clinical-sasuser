915        /* helper: count the rows of a dataset that satisfy a condition */
916        %macro _qc_rows(ds=, where=, expect=1, desc=);
917          %local rc;
918          proc sql noprint;
919            select count(*) into :rc from &ds. where &where.;
920          quit;
921          %qc_check_eq(actual=&rc., expect=&expect., desc=&desc.);
922        %mend _qc_rows;
