912        /* helper: count the rows of a dataset that satisfy a condition */
913        %macro _qc_rows(ds=, where=, expect=1, desc=);
914          %local rc;
915          proc sql noprint;
916            select count(*) into :rc from &ds. where &where.;
917          quit;
918          %qc_check_eq(actual=&rc., expect=&expect., desc=&desc.);
