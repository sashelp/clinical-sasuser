915        %macro _qc_rows(ds=, where=, expect=1, desc=);
916          %local rc;
917          proc sql noprint;
918            select count(*) into :rc from &ds. where &where.;
919          quit;
920          %qc_check_eq(actual=&rc., expect=&expect., desc=&desc.);
921        %mend _qc_rows;
922        
