923        %macro _qc_colabs(ds=, var=, mac=);
924          %global &mac.;
925          %let _did_=%sysfunc(open(&ds.));
926          %if &_did_.^=0 %then %do;
927            %let &mac.=%sysfunc(varnum(&_did_,&var.));
928            %let _did_=%sysfunc(close(&_did_));
929          %end;
930          %else %let &mac.=-1;
931        %mend _qc_colabs;
