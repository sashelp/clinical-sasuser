1          /*==============================================================================
2           * stat_summaryc_bug_noclass_testnone.sas - Bug regression: TEST= not forced to NONE when CLASS= identifies a
2        ! single group
3           *==============================================================================
4           * Macro under test : %stat_summaryc
5           * Expected         : when CLASS= is not specified, or no CLASS= value is
6           *                    nonmissing, all observations form one overall group, so
7           *                    TEST= is forced to NONE and the output carries no
8           *                    _TESTV_ / _TESTP_ / _TESTM_ columns
9           * Status           : OPEN 2026-11-01
10          * Original defect  : the forcing block is gated by "%if &class.^=" (line 124),
11          *                    therefore an empty or all-missing CLASS= skips it and TEST=
12          *                    stays active; PROC FREQ produces no test statistics, so
13          *                    every analysis variable shows .N / .N / N/A
14          * Fix              : apply the single-group check after CLASS= is empty or
15          *                    classallmissing=1 is set, not only inside the &class.^= gate
16          * Test passes when  the defect is fixed (run_all then reports FIXED)
17          *============================================================================*/
18         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
19         %let _qcboot_=%sysfunc(getoption(sysin));
20         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
21         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
22         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
23         %include "&_qcboot_.\_framework\qc_env.sas";
88         %let _qcboot_=;
89         /*----------------------------------------------------------------------------*/
