1          /*==============================================================================
2           * stat_rateci_bug_noby.sas - Bug regression: BY= empty cannot be processed
3           *==============================================================================
4           * Macro under test : %stat_rateci
5           * Expected         : with BY= omitted the macro still produces the same result
6           *                    as a single level BY= variable (the macro has an explicit
7           *                    empty BY= branch, so empty BY= is meant to be supported)
8           * Status           : FIXED 2026-10-30 - section 2.1.2 now has a separate SQL
9           *                    branch for empty BY= (select b.*, c.* / group by class)
10          * Original defect  : the 2.1.2 SQL builds "select distinct from ...",
11          *                    "group by a.," and "countw()" with no argument when BY=
12          *                    is empty, so the step stops with ERROR 22-322 plus
13          *                    "COUNTW 参数过少" and the macro terminates without
14          *                    creating the OUT= dataset
15          * Fix              : build a separate SQL branch for empty BY= that does not
16          *                    reference the BY variables, or validate BY= at entry
17          * Test passes when  the defect is fixed (run_all then reports FIXED).
18          *============================================================================*/
19         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
20         %let _qcboot_=%sysfunc(getoption(sysin));
21         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
22         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
