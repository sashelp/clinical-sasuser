1          /*==============================================================================
2           * stat_rateci_bug_riskdifflevel.sas - Bug regression: rate difference uses the wrong level
3           *==============================================================================
4           * Macro under test : %stat_rateci
5           * Expected         : every risk difference equals
6           *                    rate(CLASS=) - rate(ref CLASS=) at the LEVEL= requested
7           * Status           : OPEN
8           * Original defect  : 2.3.2 computes "column=&levelnumber." once from the first
9           *                    two observations of stat_rateci_pairwise, but PROC FREQ
10          *                    with ORDER=DATA builds the column order from the row
11          *                    order of each BY group. When one class lists its VAR=
12          *                    values in the opposite order, the difference of that pair
13          *                    is computed for the other level, so the sign or the value
14          *                    is wrong while no error is reported
15          * Fix              : force a stable column order before PROC FREQ, e.g. sort
16          *                    stat_rateci_pairwise by _pair_ &BY. and a flag that puts
17          *                    the LEVEL= row first for every class, so column= always
18          *                    points to the requested level
19          * Test passes when  the defect is fixed (run_all then reports FIXED).
20          *============================================================================*/
21         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
22         %let _qcboot_=%sysfunc(getoption(sysin));
23         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
24         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
25         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
26         %include "&_qcboot_.\_framework\qc_env.sas";
91         %let _qcboot_=;
92         /*----------------------------------------------------------------------------*/
93         %include "&_QCFW_.";
386        %include "&_QCDEV_VAR_.\var_exist.sas";
437        %include "&_QCDEV_VAR_.\var_coexist.sas";
503        %include "&_QCDEV_DS_.\ds_attr.sas";
555        %include "&_QCDEV_STAT_.\stat_rateci.sas";
952        
953        %qc_begin(prog=stat_rateci_bug_riskdifflevel, macro=stat_rateci);
#####QC_BEGIN prog=stat_rateci_bug_riskdifflevel macro=stat_rateci
