1          /*==============================================================================
2           * stat_rateci_bug_dmethod_all.sas - Bug regression: DMETHOD=ALL is never expanded
3           *==============================================================================
4           * Macro under test : %stat_rateci
5           * Expected         : DMETHOD=ALL requests AC, EXACT, HA, MN, NEWCOMBE and WALD,
6           *                    so each ordered pair yields six rows
7           * Status           : FIXED 2026-10-30 - "%if dmethod=ALL" changed to "%if &dmethod.=ALL"
8           * Original defect  : the macro uses "%if dmethod=ALL" without "&", so the
9           *                    comparison is between the literal words dmethod and ALL
10          *                    and never becomes true. The unexpanded token ALL is then
11          *                    passed to PROC FREQ as "riskdiff(cl=(ALL))", which is not
12          *                    a valid risk difference request: the step issues
13          *                    ERROR 22-322, no PDiffCls table is created, the following
14          *                    data steps fail and the OUT= dataset ends up with 0
15          *                    observations while the log stays full of ERRORs
16          * Fix              : change "%if dmethod=ALL" to "%if &dmethod.=ALL"
17          * Test passes when  the defect is fixed (run_all then reports FIXED).
18          *============================================================================*/
19         /*--- bootstrap: derive repo root from SYSIN, no absolute paths (qc_env.sas) ---*/
20         %let _qcboot_=%sysfunc(getoption(sysin));
21         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
22         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
23         %let _qcboot_=%substr(&_qcboot_.,1,%eval(%length(&_qcboot_.)-%length(%scan(&_qcboot_.,-1,%str(\)))-1));
24         %include "&_qcboot_.\_framework\qc_env.sas";
