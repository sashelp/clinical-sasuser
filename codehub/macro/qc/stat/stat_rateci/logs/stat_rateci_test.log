971        /*----------------------------------------------------------------------------
972         * Shared input data (BY= study is a single level, so results equal the
973         * ungrouped case):
974         *   trt A : 20 subjects, 5 with resp=Y  -> 25.0 %
975         *   trt B : 20 subjects, 11 with resp=Y -> 55.0 %
976         *   by sex: A = 20.0 / 30.0, B = 50.0 / 60.0
977         *--------------------------------------------------------------------------*/
978        data rates;
979          length subj $12 study $2 trt $1 sex $1 resp $1;
980          retain _k 0;
981          input study $ trt $ sex $ resp $ n;
982          do i=1 to n;
983            _k+1;
984            subj=cats(trt,sex,_k);
985            output;
986          end;
987          drop n i;
988        datalines;

