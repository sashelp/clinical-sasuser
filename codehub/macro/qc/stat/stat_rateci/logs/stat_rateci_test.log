962        /*----------------------------------------------------------------------------
963         * Shared input data (BY= study is a single level, so results equal the
964         * ungrouped case):
965         *   trt A : 20 subjects, 5 with resp=Y  -> 25.0 %
966         *   trt B : 20 subjects, 11 with resp=Y -> 55.0 %
967         *   by sex: A = 20.0 / 30.0, B = 50.0 / 60.0
968         *--------------------------------------------------------------------------*/
969        data rates;
970          length subj $12 study $2 trt $1 sex $1 resp $1;
971          retain _k 0;
972          input study $ trt $ sex $ resp $ n;
973          do i=1 to n;
974            _k+1;
975            subj=cats(trt,sex,_k);
976            output;
977          end;
978          drop n i;
979        datalines;

