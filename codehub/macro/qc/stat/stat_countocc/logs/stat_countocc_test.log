779        /*----------------------------------------------------------------------------
780         * Shared input data
781         *   treatment A : S1..S5 (5 subjects, S1-S3 with events, S4-S5 without)
782         *   treatment B : S6..S8 (3 subjects, all with events)
783         *   S9 has missing treatment -> must be excluded from every denominator
784         *   S2 has the same event twice  -> counts as 1 subject but 2 events
785         *   S8 has a missing AEDECOD     -> imputed with UNCODE=
786         *--------------------------------------------------------------------------*/
787        data adae;
788          length usubjid $10 trt $3 aebodsys $20 aedecod $20;
789          input usubjid $ trt $ aebodsys $ aedecod $;
790          datalines;

