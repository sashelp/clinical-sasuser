553        %macro _qc_use_coexist(ds=,var=,expect_branch=);
554          %if %var_coexist(data=&ds.,var=&var.) %then %do;
555            %let branch=THEN;
556          %end;
557          %else %do;
558            %let branch=ELSE;
559          %end;
560          %qc_check_eq(actual=&branch., expect=&expect_branch., desc=C11 branch chosen);
561        %mend _qc_use_coexist;
562        
