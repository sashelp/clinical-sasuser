546        %qc_begin(prog=file_attr_test, macro=file_attr);
#####QC_BEGIN prog=file_attr_test macro=file_attr
547        
548        /* f1.txt contains "qc-sandbox-f1" = 13 bytes (no CRLF added by _qc_sb_mkfile) */
4                                                       SAS 系统       2026年11月 9日 星期一 下午02时05分00秒

549        %let _file_=&_QCSB_TXT_.;
550        %qc_expect_file(file=&_file_., expect=1, desc=C0 sandbox f1 exists);
#####QC_PASS n=0 desc=C0 sandbox f1 exists
551        
552        /*----------------------------------------------------------------------------
553         * CASE 1 : FILENAME (returns the full path seen by SAS)
554         *--------------------------------------------------------------------------*/
555        %qc_case(desc=1 FILENAME);
#####QC_CASE n=1 desc=1 FILENAME
556        %let _r=%file_attr(file=&_file_.,attr=filename);
557        %qc_check(cond=%bquote(&_r.)^=%bquote(), desc=C1 filename not empty);
#####QC_PASS n=1 desc=C1 filename not empty
558        %qc_check(cond=%index(%bquote(&_r.),f1.txt)>0, desc=C1 filename contains f1.txt);
#####QC_PASS n=1 desc=C1 filename contains f1.txt
559        
560        /*----------------------------------------------------------------------------
561         * CASE 2 : RECFM (record format)
562         *--------------------------------------------------------------------------*/
563        %qc_case(desc=2 RECFM);
#####QC_CASE n=2 desc=2 RECFM
564        %let _r=%file_attr(file=&_file_.,attr=recfm);
565        %qc_check_eq(actual=&_r., expect=V, desc=C2 recfm V);
#####QC_PASS n=2 desc=C2 recfm V
566        
567        /*----------------------------------------------------------------------------
568         * CASE 3 : LRECL (record length, platform default)
569         *--------------------------------------------------------------------------*/
570        %qc_case(desc=3 LRECL);
#####QC_CASE n=3 desc=3 LRECL
571        %let _r=%file_attr(file=&_file_.,attr=lrecl);
572        %qc_check(cond=%bquote(&_r.)^=%bquote(), desc=C3 lrecl not empty);
#####QC_PASS n=3 desc=C3 lrecl not empty
573        
574        /*----------------------------------------------------------------------------
575         * CASE 4 : FILESIZE (15 bytes: "qc-sandbox-f1" + CRLF written by sandbox)
576         *--------------------------------------------------------------------------*/
577        %qc_case(desc=4 FILESIZE);
#####QC_CASE n=4 desc=4 FILESIZE
578        %let _r=%file_attr(file=&_file_.,attr=filesize);
579        %qc_check_eq(actual=&_r., expect=15, desc=C4 filesize 15 bytes);
#####QC_PASS n=4 desc=C4 filesize 15 bytes
580        
581        /*----------------------------------------------------------------------------
582         * CASE 5 : CRDTM and MODTM are non-empty strings
583         *--------------------------------------------------------------------------*/
584        %qc_case(desc=5 CRDTM and MODTM);
#####QC_CASE n=5 desc=5 CRDTM and MODTM
585        %let _r=%file_attr(file=&_file_.,attr=crdtm);
586        %qc_check(cond=%bquote(&_r.)^=%bquote(), desc=C5 crdtm not empty);
#####QC_PASS n=5 desc=C5 crdtm not empty
587        %let _r=%file_attr(file=&_file_.,attr=modtm);
588        %qc_check(cond=%bquote(&_r.)^=%bquote(), desc=C5 modtm not empty);
#####QC_PASS n=5 desc=C5 modtm not empty
589        
590        /*----------------------------------------------------------------------------
591         * CASE 6 : ATTR= value is case-insensitive
592         *--------------------------------------------------------------------------*/
593        %qc_case(desc=6 ATTR case-insensitive);
#####QC_CASE n=6 desc=6 ATTR case-insensitive
594        %let _r=%file_attr(file=&_file_.,attr=FILENAME);
595        %qc_check(cond=%bquote(&_r.)^=%bquote(), desc=C6 uppercase FILENAME not empty);
#####QC_PASS n=6 desc=C6 uppercase FILENAME not empty
596        
597        %qc_end;
